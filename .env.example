# 生产部署请固定已验证的版本号，例如 v1.2.3；首次试运行可用 latest。
ROLLBOOK_VERSION=latest
ROLLBOOK_BIND_ADDR=127.0.0.1
ROLLBOOK_PORT=8080
ROLLBOOK_ALLOW_INSECURE_HTTP=false
TZ=Asia/Shanghai
# 留空时 YAML 备份位于 /data；设为 /backups 可使用独立持久卷。
ROLLBOOK_BACKUP_DIR=
# 可选首次管理员：推荐使用 compose.bootstrap.yaml 与 secrets/bootstrap_password。
# ROLLBOOK_BOOTSTRAP_USER=owner
# 不使用 Docker secret 时可设 ROLLBOOK_BOOTSTRAP_PASSWORD；不要与口令文件同时设置。
# ROLLBOOK_BOOTSTRAP_PASSWORD=
